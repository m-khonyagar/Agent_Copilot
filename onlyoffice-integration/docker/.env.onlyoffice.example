# ─────────────────────────────────────────────────────────────────────────────
# Environment variables to add for ONLYOFFICE integration
# Append these to your existing .env file in Amline_namAvaran
# ─────────────────────────────────────────────────────────────────────────────

# ONLYOFFICE Document Server
# Generate a secure secret: openssl rand -hex 32
ONLYOFFICE_JWT_SECRET=change-me-use-openssl-rand-hex-32

# URL of the ONLYOFFICE Document Server (accessible from the BROWSER)
# If using Docker, this is the public-facing URL (via Nginx or exposed port)
AMLINE_ONLYOFFICE_SERVER_URL=http://localhost:8180

# URL base that ONLYOFFICE Document Server will use to call back to the backend
# Must be reachable from inside the Docker network
# Example (Docker): http://backend:8000
# Example (public): https://api.amline.ir
AMLINE_ONLYOFFICE_CALLBACK_BASE_URL=http://backend:8000
